// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
#pragma once
// AMD source is embedded unchanged; see third-party/fsr1/LICENSE.
static const char *commonShader = R"CNGX(
Texture2D<float4> a : register(t0);
Texture2D<float4> b : register(t1);
Texture2D<float4> c : register(t2);
Texture2D<float4> d : register(t3);
Texture2D<int2> optical : register(t4);
RWTexture2D<float4> target : register(u0);
// Integer views of the same slots, used only by the projection passes below.
Texture2D<uint> bitsIn : register(t0);
RWTexture2D<uint> targetBits : register(u0);
SamplerState clampSampler : register(s0);
cbuffer Params : register(b0) {
    uint2 sourceSize; uint2 outputSize;
    float2 vectorScale; float sharpness; uint resetHistory;
    float4 extraA; float4 extraB;
};
[numthreads(8,8,1)] void scaleMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    target[p.xy] = a.SampleLevel(clampSampler, (p.xy+0.5)/outputSize, 0);
}
[numthreads(8,8,1)] void grayMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float3 rgb = a.SampleLevel(clampSampler,(p.xy+0.5)/outputSize,0).rgb;
    target[p.xy] = dot(rgb,float3(0.2126,0.7152,0.0722));
}
[numthreads(8,8,1)] void zeroMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    target[p.xy] = 0;
}
[numthreads(8,8,1)] void motionMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float2 g = (p.xy+0.5)*sourceSize/outputSize-0.5;
    int2 lo = int2(floor(g));
    float2 f = frac(g);
    int2 limit = int2(sourceSize)-1;
    float2 v00 = optical.Load(int3(clamp(lo,int2(0,0),limit),0));
    float2 v10 = optical.Load(int3(clamp(lo+int2(1,0),int2(0,0),limit),0));
    float2 v01 = optical.Load(int3(clamp(lo+int2(0,1),int2(0,0),limit),0));
    float2 v11 = optical.Load(int3(clamp(lo+int2(1,1),int2(0,0),limit),0));
    float2 v = lerp(lerp(v00,v10,f.x),lerp(v01,v11,f.x),f.y);
    target[p.xy] = float4(v/32.0*vectorScale,0,0);
}
// --- Motion refinement -------------------------------------------------------
// Vectors are in source-luma pixels, pointing from the current frame to the
// previous one (the NVOFA output divided by its S10.5 scale).
float2 flowAt(int2 q, int2 limit) {
    return float2(optical.Load(int3(clamp(q,int2(0,0),limit),0)))/32.0;
}
#define SORT2(x,y) { float2 low_ = min(x,y); y = max(x,y); x = low_; }
// 3x3 component-wise median, then snap to the fitted global (camera) model.
// extraA = (a0,a1,a2,valid), extraB = (b0,b1,b2,snap pixels); model coordinates
// are grid positions normalised to [-0.5,0.5]. A rigid background then moves as
// one surface instead of wobbling with per-block estimation noise.
[numthreads(8,8,1)] void refineMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    int2 limit = int2(sourceSize)-1;
    float2 v[9];
    for(int j=0;j<3;++j) for(int i=0;i<3;++i)
        v[j*3+i] = flowAt(int2(p.xy)+int2(i-1,j-1),limit);
    SORT2(v[1],v[2]) SORT2(v[4],v[5]) SORT2(v[7],v[8])
    SORT2(v[0],v[1]) SORT2(v[3],v[4]) SORT2(v[6],v[7])
    SORT2(v[1],v[2]) SORT2(v[4],v[5]) SORT2(v[7],v[8])
    SORT2(v[0],v[3]) SORT2(v[5],v[8]) SORT2(v[4],v[7])
    SORT2(v[3],v[6]) SORT2(v[1],v[4]) SORT2(v[2],v[5])
    SORT2(v[4],v[7]) SORT2(v[4],v[2]) SORT2(v[6],v[4])
    SORT2(v[4],v[2])
    float2 m = v[4];
    if(extraA.w > 0.5) {
        float2 u = (p.xy+0.5)/outputSize-0.5;
        float2 g = float2(extraA.x+extraA.y*u.x+extraA.z*u.y,
                          extraB.x+extraB.y*u.x+extraB.z*u.y);
        float snap = extraB.w+0.03*length(g);
        m = lerp(g,m,smoothstep(snap,2.0*snap,length(m-g)));
    }
    target[p.xy] = float4(m,0,0);
}
// a = refined vectors, b = current luma, c = previous luma. Photometric error of
// the motion-compensated match; extraA.xy = (reliable below, unreliable above).
[numthreads(8,8,1)] void confidenceMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    uint lw, lh; b.GetDimensions(lw,lh);
    float2 lumaSize = float2(lw,lh);
    float2 center = (p.xy+0.5)*lumaSize/outputSize;
    float2 v = a.Load(int3(p.xy,0)).xy;
    float error = 0;
    for(int j=-1;j<=1;++j) for(int i=-1;i<=1;++i) {
        float2 q = center+float2(i,j)*2.0;
        float now = b.SampleLevel(clampSampler,q/lumaSize,0).r;
        float before = c.SampleLevel(clampSampler,(q+v)/lumaSize,0).r;
        error += abs(now-before);
    }
    float confidence = 1.0-smoothstep(extraA.x,extraA.y,error/9.0);
    target[p.xy] = float4(confidence,confidence,confidence,1);
}
// a = refined vectors (grid), b = current luma. Joint-bilateral upsampling:
// a pixel takes the vector of the grid cells that look like it, so motion
// boundaries follow image edges instead of being blurred across them.
// extraA.x = luma similarity sigma.
[numthreads(8,8,1)] void guidedMotionMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float2 uv = (p.xy+0.5)/outputSize;
    float2 g = uv*sourceSize-0.5;
    int2 lo = int2(floor(g));
    float2 f = frac(g);
    int2 limit = int2(sourceSize)-1;
    float guide = b.SampleLevel(clampSampler,uv,0).r;
    float2 sum = float2(0,0);
    float weight = 0;
    for(int j=0;j<2;++j) for(int i=0;i<2;++i) {
        int2 q = clamp(lo+int2(i,j),int2(0,0),limit);
        float spatial = (i ? f.x : 1.0-f.x)*(j ? f.y : 1.0-f.y);
        float cell = b.SampleLevel(clampSampler,(q+0.5)/sourceSize,0).r;
        float d = (cell-guide)/extraA.x;
        float w = spatial*exp(-d*d)+1e-4;
        sum += a.Load(int3(q,0)).xy*w;
        weight += w;
    }
    target[p.xy] = float4(sum/weight*vectorScale,0,0);
}
// a = generated frame, b = nearest real frame, c = confidence (grid). Where the
// motion estimate is unreliable, repeat the real frame instead of warping.
[numthreads(8,8,1)] void fallbackMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float confidence = c.SampleLevel(clampSampler,(p.xy+0.5)/outputSize,0).r;
    float3 generated = a.Load(int3(p.xy,0)).rgb;
    float3 real = b.Load(int3(p.xy,0)).rgb;
    target[p.xy] = float4(lerp(real,generated,confidence),1);
}
// Experimental flow-based interpolation (CHIAKI_ENHANCEMENT_FG_BACKEND=flow).
// Two passes per generated phase, t in (0,1) from the previous to the current frame.
//
// selectMain (half resolution) chooses one motion vector per pixel of the
// intermediate frame from a small candidate set, by the photometric error of a
// 4-tap patch between the two real frames along that vector:
//   - "did not move" (favoured by a small margin: vector noise on static content
//     must not cost sharpness),
//   - the field vector followed to this pixel's surface, and the raw field vector,
//   - the field vectors of neighbours at two radii. At occlusion borders and where
//     new content enters the frame the local vector has no real match; a
//     neighbour's vector (the surface that actually covers this pixel) then wins.
// Deciding on patches at half resolution keeps the choice spatially stable: the
// per-pixel decision of the previous version speckled thin structures.
// a = previous real, b = current real, c = motion in output pixels (current ->
// previous). extraA = (t, -, -, margin), extraB = (radius 1, radius 2 in pixels,
// error assumed when a sample leaves the frame, -).
// Output: xy = chosen vector in output pixels, z = its error.
float pairError(float2 x, float2 g, float t, float2 size) {
    float2 pc = x-(1.0-t)*g;
    float2 pp = x+t*g;
    if(any(pc < 0.0) || any(pc > size) || any(pp < 0.0) || any(pp > size)) return extraB.z;
    static const float2 taps[4] = {float2(-1.5,-1.5),float2(1.5,-1.5),float2(-1.5,1.5),float2(1.5,1.5)};
    float e = 0;
    for(int k=0;k<4;++k)
        e += dot(abs(b.SampleLevel(clampSampler,(pc+taps[k])/size,0).rgb-
                     a.SampleLevel(clampSampler,(pp+taps[k])/size,0).rgb),float3(0.299,0.587,0.114));
    return e*0.25;
}
[numthreads(8,8,1)] void selectMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float t = extraA.x;
    float2 size = float2(sourceSize);
    float2 x = (p.xy+0.5)*size/float2(outputSize);
    float2 g0 = c.SampleLevel(clampSampler,x/size,0).xy;
    // The vector field lives on the current frame: follow it to the surface that
    // passes through this pixel at time t.
    float2 gi = g0;
    for(int k=0;k<2;++k) gi = c.SampleLevel(clampSampler,(x-(1.0-t)*gi)/size,0).xy;
    float2 best = float2(0,0);
    float bestError = pairError(x,best,t,size)-extraA.w;
    float e = pairError(x,gi,t,size);
    if(e < bestError) { bestError = e; best = gi; }
    e = pairError(x,g0,t,size)+extraA.w;
    if(e < bestError) { bestError = e; best = g0; }
    static const float2 directions[4] = {float2(1,0),float2(-1,0),float2(0,1),float2(0,-1)};
    for(int r=0;r<2;++r) {
        float radius = r == 0 ? extraB.x : extraB.y;
        for(int d=0;d<4;++d) {
            float2 gn = c.SampleLevel(clampSampler,(x+directions[d]*radius)/size,0).xy;
            e = pairError(x,gn,t,size)+extraA.w;
            if(e < bestError) { bestError = e; best = gn; }
        }
    }
    target[p.xy] = float4(best,max(bestError,0.0),0);
}
// 9-tap Catmull-Rom through 3x3 bilinear fetches: keeps moved detail sharp and
// returns the texel itself at integer positions.
float3 sampleSharp(Texture2D<float4> image, float2 uv, float2 size) {
    float2 position = uv*size;
    float2 base = floor(position-0.5)+0.5;
    float2 f = position-base;
    float2 w0 = f*(-0.5+f*(1.0-0.5*f));
    float2 w1 = 1.0+f*f*(-2.5+1.5*f);
    float2 w2 = f*(0.5+f*(2.0-1.5*f));
    float2 w3 = f*f*(-0.5+0.5*f);
    float2 w12 = w1+w2;
    float2 p0 = (base-1.0)/size;
    float2 p3 = (base+2.0)/size;
    float2 p12 = (base+w2/w12)/size;
    float3 r = image.SampleLevel(clampSampler,float2(p0.x,p0.y),0).rgb*(w0.x*w0.y);
    r += image.SampleLevel(clampSampler,float2(p12.x,p0.y),0).rgb*(w12.x*w0.y);
    r += image.SampleLevel(clampSampler,float2(p3.x,p0.y),0).rgb*(w3.x*w0.y);
    r += image.SampleLevel(clampSampler,float2(p0.x,p12.y),0).rgb*(w0.x*w12.y);
    r += image.SampleLevel(clampSampler,float2(p12.x,p12.y),0).rgb*(w12.x*w12.y);
    r += image.SampleLevel(clampSampler,float2(p3.x,p12.y),0).rgb*(w3.x*w12.y);
    r += image.SampleLevel(clampSampler,float2(p0.x,p3.y),0).rgb*(w0.x*w3.y);
    r += image.SampleLevel(clampSampler,float2(p12.x,p3.y),0).rgb*(w12.x*w3.y);
    r += image.SampleLevel(clampSampler,float2(p3.x,p3.y),0).rgb*(w3.x*w3.y);
    return saturate(r);
}
// a = previous real, b = current real, c = selectMain's output for this phase.
// extraA = (t, consistent below, inconsistent above). Both frames are sampled
// along the chosen vector; where they still disagree (a real occlusion) or one
// sample leaves the frame, the compensated sample of the temporally nearer / the
// in-frame image is used alone.
[numthreads(8,8,1)] void interpolateMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float t = extraA.x;
    float2 size = float2(outputSize);
    float2 x = p.xy+0.5;
    float2 g = c.SampleLevel(clampSampler,x/size,0).xy;
    float2 fromCurrent = (x-(1.0-t)*g)/size;
    float2 fromPrevious = (x+t*g)/size;
    float3 current = sampleSharp(b,fromCurrent,size);
    float3 previous = sampleSharp(a,fromPrevious,size);
    bool currentInside = all(fromCurrent >= 0.0) && all(fromCurrent <= 1.0);
    bool previousInside = all(fromPrevious >= 0.0) && all(fromPrevious <= 1.0);
    float mismatch = dot(abs(current-previous),float3(0.299,0.587,0.114));
    float nearer = t >= 0.5 ? 1.0 : 0.0;
    float w = lerp(t,nearer,smoothstep(extraA.y,extraA.z,mismatch));
    if(currentInside && !previousInside) w = 1.0;
    if(previousInside && !currentInside) w = 0.0;
    target[p.xy] = float4(lerp(previous,current,w),1);
}
// ---------------------------------------------------------------------------
// Projected flow interpolation (default of the flow backend). Developed offline
// against the worker's dumped NVOFA grids and the recorded 120 fps truth frames;
// docs/diy/vsr-and-statistics.md has the numbers.
//
// The vector field is defined on the current frame. For an intermediate frame it
// is projected forward to time t on the flow grid instead of being looked up
// through the field itself:
//   matchMain    error of every grid vector between the two real frames. Vectors
//                without a real match (content that just entered the frame, the
//                revealed side of an occlusion) are dropped.
//   splatMain    each surviving vector is written to the cell it reaches at time
//                t; where several land, the best match wins (atomic minimum).
//   resolveMain  packed winner -> vector in output pixels, with a validity flag.
//   fillMain     holes take the motion of their valid neighbours, coarse to fine:
//                the surface next to a revealed region moves on into it.
//   medianFieldMain removes single-cell outliers.
//   heldMain / weightMain compare "moved" against "did not move" on blocks and
//                blur the decision, so it is spatially stable (a per-pixel
//                decision speckled thin structures).
//   interpolateProjectedMain samples both frames along the vector.
static const float2 quad[4] = {float2(-0.25,-0.25),float2(0.25,-0.25),float2(-0.25,0.25),float2(0.25,0.25)};
// a = previous real, b = current real (output size), optical = raw grid.
// vectorScale = output pixels per flow pixel. Output r = error, 1 for invalid.
[numthreads(8,8,1)] void matchMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    int2 raw = optical.Load(int3(p.xy,0));
    if(raw.x == -32768 || raw.y == -32768) { target[p.xy] = float4(1,0,0,0); return; }
    float2 size = float2(sourceSize);
    float2 cell = size/float2(outputSize);
    float2 x = (p.xy+0.5)*cell;
    float2 v = float2(raw)/32.0*vectorScale;
    float e = 0;
    for(int k=0;k<4;++k) {
        float2 q = x+quad[k]*cell;
        e += dot(abs(b.SampleLevel(clampSampler,q/size,0).rgb-a.SampleLevel(clampSampler,(q+v)/size,0).rgb),
                 float3(0.299,0.587,0.114));
    }
    target[p.xy] = float4(e*0.25,0,0,0);
}
[numthreads(8,8,1)] void clearBitsMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    targetBits[p.xy] = 0xFFFFFFFFu;
}
// a = matchMain's output, optical = raw grid. extraA = (t, error threshold,
// grid cells per flow pixel x, y). Packed value: 12-bit error, 20-bit source cell.
[numthreads(8,8,1)] void splatMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    int2 raw = optical.Load(int3(p.xy,0));
    if(raw.x == -32768 || raw.y == -32768) return;
    float e = a.Load(int3(p.xy,0)).r;
    if(e >= extraA.y) return;
    float2 cells = float2(raw)/32.0*extraA.zw;
    int2 q = int2(floor(float2(p.xy)+(1.0-extraA.x)*cells+0.5));
    if(any(q < 0) || any(q >= int2(outputSize))) return;
    uint packed = (uint(min(e,1.0)*4095.0+0.5) << 20) | (p.y*outputSize.x+p.x);
    InterlockedMin(targetBits[q],packed);
}
// bitsIn = splat result, optical = raw grid, vectorScale = output pixels per flow
// pixel. Output xy = vector in output pixels, z = 1 where a vector landed.
[numthreads(8,8,1)] void resolveMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    uint packed = bitsIn.Load(int3(p.xy,0));
    if(packed == 0xFFFFFFFFu) { target[p.xy] = float4(0,0,0,0); return; }
    uint index = packed & 0xFFFFFu;
    int2 source = int2(index % outputSize.x,index / outputSize.x);
    target[p.xy] = float4(float2(optical.Load(int3(source,0)))/32.0*vectorScale,1,0);
}
// a = field. extraA.x = stride in cells.
[numthreads(8,8,1)] void fillMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float4 v = a.Load(int3(p.xy,0));
    if(v.z > 0.5) { target[p.xy] = v; return; }
    int stride = int(extraA.x);
    int2 limit = int2(outputSize)-1;
    float2 sum = float2(0,0);
    float count = 0;
    for(int j=-1;j<=1;++j) for(int i=-1;i<=1;++i) {
        if(i == 0 && j == 0) continue;
        float4 n = a.Load(int3(clamp(int2(p.xy)+int2(i,j)*stride,int2(0,0),limit),0));
        if(n.z > 0.5) { sum += n.xy; count += 1.0; }
    }
    target[p.xy] = count > 0.0 ? float4(sum/count,1,0) : float4(0,0,0,0);
}
[numthreads(8,8,1)] void medianFieldMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    int2 limit = int2(outputSize)-1;
    float2 v[9];
    for(int j=0;j<3;++j) for(int i=0;i<3;++i)
        v[j*3+i] = a.Load(int3(clamp(int2(p.xy)+int2(i-1,j-1),int2(0,0),limit),0)).xy;
    SORT2(v[1],v[2]) SORT2(v[4],v[5]) SORT2(v[7],v[8])
    SORT2(v[0],v[1]) SORT2(v[3],v[4]) SORT2(v[6],v[7])
    SORT2(v[1],v[2]) SORT2(v[4],v[5]) SORT2(v[7],v[8])
    SORT2(v[0],v[3]) SORT2(v[5],v[8]) SORT2(v[4],v[7])
    SORT2(v[3],v[6]) SORT2(v[1],v[4]) SORT2(v[2],v[5])
    SORT2(v[4],v[7]) SORT2(v[4],v[2]) SORT2(v[6],v[4])
    SORT2(v[4],v[2])
    target[p.xy] = float4(v[4],1,0);
}
// a = previous real, b = current real, c = field (grid). extraA.x = t.
// Output r = block error along the vector, g = block error without motion.
[numthreads(8,8,1)] void heldMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float t = extraA.x;
    float2 size = float2(sourceSize);
    float2 cell = size/float2(outputSize);
    float2 x = (p.xy+0.5)*cell;
    float2 g = c.Load(int3(p.xy,0)).xy;
    float3 luma = float3(0.299,0.587,0.114);
    float moved = 0, still = 0;
    for(int k=0;k<4;++k) {
        float2 q = x+quad[k]*cell;
        moved += dot(abs(b.SampleLevel(clampSampler,(q-(1.0-t)*g)/size,0).rgb-
                         a.SampleLevel(clampSampler,(q+t*g)/size,0).rgb),luma);
        still += dot(abs(b.SampleLevel(clampSampler,q/size,0).rgb-a.SampleLevel(clampSampler,q/size,0).rgb),luma);
    }
    target[p.xy] = float4(moved*0.25,still*0.25,0,0);
}
// a = heldMain's output, b = field. extraA.w = margin. Output xy = vector,
// z = weight of the "did not move" result (3x3 blurred decision), w = blurred
// block error along the vector.
[numthreads(8,8,1)] void weightMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    int2 limit = int2(outputSize)-1;
    float2 e = float2(0,0);
    for(int j=-1;j<=1;++j) for(int i=-1;i<=1;++i)
        e += a.Load(int3(clamp(int2(p.xy)+int2(i,j),int2(0,0),limit),0)).xy;
    e /= 9.0;
    target[p.xy] = float4(b.Load(int3(p.xy,0)).xy,smoothstep(-extraA.w,2.0*extraA.w,e.x-e.y),e.x);
}
// a = previous real, b = current real, c = weightMain's output (grid).
// extraA = (t, consistent below, inconsistent above), extraB.x > 0.5 = Catmull-Rom.
[numthreads(8,8,1)] void interpolateProjectedMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float t = extraA.x;
    float2 size = float2(outputSize);
    float2 x = p.xy+0.5;
    float4 field = c.SampleLevel(clampSampler,x/size,0);
    float2 g = field.xy;
    float2 fromCurrent = (x-(1.0-t)*g)/size;
    float2 fromPrevious = (x+t*g)/size;
    float3 current, previous;
    if(extraB.x > 0.5) {
        current = sampleSharp(b,fromCurrent,size);
        previous = sampleSharp(a,fromPrevious,size);
    } else {
        current = b.SampleLevel(clampSampler,fromCurrent,0).rgb;
        previous = a.SampleLevel(clampSampler,fromPrevious,0).rgb;
    }
    bool currentInside = all(fromCurrent >= 0.0) && all(fromCurrent <= 1.0);
    bool previousInside = all(fromPrevious >= 0.0) && all(fromPrevious <= 1.0);
    // Where the two frames disagree along the vector, only the nearer one is used.
    // The decision follows the blurred block error, not this pixel's own difference:
    // offline it scored slightly higher on every clip and has no per-pixel edges.
    float nearer = t >= 0.5 ? 1.0 : 0.0;
    float w = lerp(t,nearer,smoothstep(extraA.y,extraA.z,field.w));
    float useHeld = field.z;
    if(currentInside && !previousInside) { w = 1.0; useHeld = 0.0; }
    if(previousInside && !currentInside) { w = 0.0; useHeld = 0.0; }
    float3 held = lerp(a.Load(int3(p.xy,0)).rgb,b.Load(int3(p.xy,0)).rgb,t);
    target[p.xy] = float4(lerp(lerp(previous,current,w),held,useHeld),1);
}
// Earlier flow interpolation ("direct"): the field vector followed to this pixel,
// with a per-pixel choice between "moved along the vector" and "did not move".
// On the recorded clips this scored above the candidate selection, which broke
// contours where a wrong surface happened to have a low photometric error.
// a = previous real, b = current real, c = motion in output pixels (current ->
// previous). extraA = (t, consistent below, inconsistent above, hypothesis margin),
// extraB.x = dead zone in pixels.
[numthreads(8,8,1)] void interpolateDirectMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float t = extraA.x;
    float2 size = float2(outputSize);
    float2 x = p.xy+0.5;
    float3 luma = float3(0.299,0.587,0.114);
    float2 g = c.SampleLevel(clampSampler,x/size,0).xy;
    for(int k=0;k<2;++k) g = c.SampleLevel(clampSampler,(x-(1.0-t)*g)/size,0).xy;
    float3 current0 = b.Load(int3(p.xy,0)).rgb;
    float3 previous0 = a.Load(int3(p.xy,0)).rgb;
    float3 held = lerp(previous0,current0,t);
    // Sub-threshold vectors are estimation noise on static content.
    if(dot(g,g) < extraB.x*extraB.x) { target[p.xy] = float4(held,1); return; }
    float2 fromCurrent = (x-(1.0-t)*g)/size;
    float2 fromPrevious = (x+t*g)/size;
    float3 current = sampleSharp(b,fromCurrent,size);
    float3 previous = sampleSharp(a,fromPrevious,size);
    bool currentInside = all(fromCurrent >= 0.0) && all(fromCurrent <= 1.0);
    bool previousInside = all(fromPrevious >= 0.0) && all(fromPrevious <= 1.0);
    float mismatch = dot(abs(current-previous),luma);
    float still = dot(abs(current0-previous0),luma);
    float nearer = t >= 0.5 ? 1.0 : 0.0;
    float w = lerp(t,nearer,smoothstep(extraA.y,extraA.z,mismatch));
    float useHeld = smoothstep(-extraA.w,2.0*extraA.w,mismatch-still);
    if(currentInside && !previousInside) { w = 1.0; useHeld = 0.0; }
    if(previousInside && !currentInside) { w = 0.0; useHeld = 0.0; }
    float3 moved = lerp(previous,current,w);
    target[p.xy] = float4(lerp(moved,held,useHeld),1);
}
[numthreads(8,8,1)] void residualMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float4 native = a.Load(int3(p.xy,0));
    target[p.xy] = float4(saturate(native.rgb+b.Load(int3(p.xy,0)).rgb-c.Load(int3(p.xy,0)).rgb),1);
}
// HDR transport is linear BT.2020, with 1.0 = 203 nits. Only the model reference
// is compressed/gamut-limited; the original HDR frame never passes through UNORM.
float3 to709(float3 v) {
    return mul(float3x3(1.660491,-0.587641,-0.072850,
                       -0.124550,1.132900,-0.008349,
                       -0.018151,-0.100579,1.118730),v);
}
float3 to2020(float3 v) {
    return mul(float3x3(0.627404,0.329283,0.043313,
                       0.069097,0.919540,0.011362,
                       0.016392,0.088013,0.895595),v);
}
float3 encodeSrgb(float3 v) {
    return float3(v.r <= 0.0031308 ? 12.92*v.r : 1.055*pow(v.r,1.0/2.4)-0.055,
                  v.g <= 0.0031308 ? 12.92*v.g : 1.055*pow(v.g,1.0/2.4)-0.055,
                  v.b <= 0.0031308 ? 12.92*v.b : 1.055*pow(v.b,1.0/2.4)-0.055);
}
float3 decodeSrgb(float3 v) {
    v = saturate(v);
    return float3(v.r <= 0.04045 ? v.r/12.92 : pow((v.r+0.055)/1.055,2.4),
                  v.g <= 0.04045 ? v.g/12.92 : pow((v.g+0.055)/1.055,2.4),
                  v.b <= 0.04045 ? v.b/12.92 : pow((v.b+0.055)/1.055,2.4));
}
[numthreads(8,8,1)] void hdrProxyMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float3 rgb = to709(a.Load(int3(p.xy,0)).rgb);
    float peak = max(0,max(rgb.r,max(rgb.g,rgb.b)));
    target[p.xy] = float4(encodeSrgb(saturate(rgb/(1+peak))),1);
}
[numthreads(8,8,1)] void hdrResidualMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    float4 original = a.Load(int3(p.xy,0));
    float3 rgb = to709(original.rgb);
    float gain = min(8.0,1+max(0,max(rgb.r,max(rgb.g,rgb.b))));
    // Compare the actual quantized/reconstructed SDR pair, not an ideal proxy:
    // equal inputs then have exactly zero delta, even outside the SDR gamut.
    float3 delta = decodeSrgb(b.Load(int3(p.xy,0)).rgb)-decodeSrgb(c.Load(int3(p.xy,0)).rgb);
    delta = clamp(delta,-0.25,0.25)*gain;
    target[p.xy] = float4(original.rgb+to2020(delta),original.a);
}
// Synthetic HDR values for GPU validation (black, shadows, diffuse white,
// specular highlights and a saturated wide-gamut primary).
[numthreads(8,8,1)] void hdrPatternMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    uint band = p.x*6/outputSize.x;
    float3 v = band==0 ? float3(0,0,0) : band==1 ? float3(0.02,0.02,0.02) :
               band==2 ? float3(1,1,1) : band==3 ? float3(5,5,5) :
               band==4 ? float3(20,20,20) : float3(4,0.1,0.05);
    target[p.xy] = float4(v,1);
}
)CNGX";

static const char *fsrShader = R"CNGX(
#define A_GPU 1
#define A_HLSL 1
#define FSR_EASU_F 1
#define FSR_RCAS_F 1
@FSR_A@
Texture2D<float4> a : register(t0);
RWTexture2D<float4> target : register(u0);
SamplerState clampSampler : register(s0);
cbuffer Params : register(b0) {
    uint2 sourceSize; uint2 outputSize;
    float2 vectorScale; float sharpness; uint resetHistory;
};
AF4 FsrEasuRF(AF2 p) {return a.GatherRed(clampSampler,p);}
AF4 FsrEasuGF(AF2 p) {return a.GatherGreen(clampSampler,p);}
AF4 FsrEasuBF(AF2 p) {return a.GatherBlue(clampSampler,p);}
AF4 FsrRcasLoadF(ASU2 p) {return a.Load(int3(clamp(p,int2(0,0),int2(sourceSize)-1),0));}
void FsrRcasInputF(inout AF1 r,inout AF1 g,inout AF1 b) {}
@FSR_ONE@
[numthreads(8,8,1)] void easuMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    AU4 c0,c1,c2,c3;
    FsrEasuCon(c0,c1,c2,c3,sourceSize.x,sourceSize.y,sourceSize.x,sourceSize.y,outputSize.x,outputSize.y);
    AF3 rgb; FsrEasuF(rgb,p.xy,c0,c1,c2,c3);
    target[p.xy] = float4(rgb,1);
}
[numthreads(8,8,1)] void rcasMain(uint3 p : SV_DispatchThreadID) {
    if(any(p.xy >= outputSize)) return;
    AU4 con; FsrRcasCon(con,2.0*(1.0-sharpness));
    AF1 r,g,b; FsrRcasF(r,g,b,p.xy,con);
    target[p.xy] = float4(r,g,b,1);
}
)CNGX";
